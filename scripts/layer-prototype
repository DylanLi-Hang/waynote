#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ ${WAYNOTE_DEV_SHELL:-} != 1 ]]; then
  exec nix develop "$repo" --command env WAYNOTE_DEV_SHELL=1 bash "$repo/scripts/layer-prototype" "$@"
fi
cd "$repo"
export WAYNOTE_PROTOTYPE_ROOT="$repo/target/layer-prototype"
export XDG_DATA_HOME="$WAYNOTE_PROTOTYPE_ROOT/data"
export XDG_STATE_HOME="$WAYNOTE_PROTOTYPE_ROOT/state"
export XDG_CONFIG_HOME="$WAYNOTE_PROTOTYPE_ROOT/config"
export GDK_BACKEND=wayland
unset HYPRLAND_INSTANCE_SIGNATURE
cargo build --locked --example layer-shell-prototype --features layer-shell-prototype
exec target/debug/examples/layer-shell-prototype "${@:-toggle}"
